# 构建产物（CMake / Ninja）
/build/
/build-*/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
*.obj
*.o
*.a
*.lib
*.pdb
*.ilk

# 二进制与可执行文件（交付目录在仓库外，仓库里不应出现）
*.exe
*.dll
*.so
*.so.*
*.dylib

# 本机运行库与本机服务端残留
/.runtime/
/api/

# 运行数据：资料库只在用户本机，不进仓库
/data/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# 本机恢复快照、临时工作目录与输出
/.recovery/
/work/
/outputs/

# 日志
*.log

# 本机文件，不上传
/AGENTS.md

# 本机目录，不上传
/.local/

# 本机记录，不上传
/refactor/docs/working-state.md

# 本机配置与凭证
.env
.env.*
!.env.example
*.local.json
*.local.ini
*.local.conf
*.pem
*.key

# IDE 与编辑器
.vs/
.idea/
.vscode/
.qtcreator/
*.user
*.user.*
CMakeUserPresets.json
.qtc_clangd/

# Python
__pycache__/
*.pyc

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
